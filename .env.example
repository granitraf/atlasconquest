# The daily leaderboard (optional). Copy this file to .env.local and fill in both values.
# Without them the game plays exactly the same and the leaderboard shows as unavailable.
#
# Both are in the Supabase dashboard under Project Settings > API. Use the PUBLIC key only
# (called "anon" or "publishable"). It is safe to ship in the page: the database lets it read
# the leaderboard and call the function that records a run, and nothing else.
# NEVER put the service_role / secret key here: anything starting with VITE_ is sent to every player.
#
# Run supabase/schema.sql once in the project's SQL editor before the first game.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# The passcode to the classic game (optional). The game ships with a hash of it in src/daily/daily.ts;
# set this to use another passcode for a build without changing the code. `npm run passcode -- NEWCODE`
# prints the number to put here. It is a hash, not the passcode, and a soft lock, not security.
# VITE_CLASSIC_PASSCODE_HASH=1234567890123456
